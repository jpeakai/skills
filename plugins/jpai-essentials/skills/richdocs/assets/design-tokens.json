{
  "fonts": {
    "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "themes": {
    "light": {
      "background": "#f8fafc",
      "foreground": "#0f172a",
      "mutedForeground": "#64748b",
      "primary": "#2563eb",
      "card": "#ffffff",
      "border": "#e2e8f0"
    },
    "dark": {
      "background": "#0f172a",
      "foreground": "#e2e8f0",
      "mutedForeground": "#94a3b8",
      "primary": "#60a5fa",
      "card": "#1e293b",
      "border": "#334155"
    }
  },
  "canvas": {
    "cytoscape": {
      "light": {
        "nodeFill": "#2563eb",
        "nodeLabel": "#0f172a",
        "edge": "#64748b",
        "compoundBg": "#f1f5f9",
        "compoundBorder": "#cbd5e1"
      },
      "dark": {
        "nodeFill": "#60a5fa",
        "nodeLabel": "#e2e8f0",
        "edge": "#94a3b8",
        "compoundBg": "#1e293b",
        "compoundBorder": "#475569"
      }
    },
    "plotly": {
      "light": {
        "paper": "#ffffff",
        "plot": "#f8fafc",
        "font": "#0f172a",
        "grid": "#e2e8f0",
        "series": [
          "#2563eb",
          "#0d9488",
          "#d97706",
          "#dc2626",
          "#7c3aed"
        ]
      },
      "dark": {
        "paper": "#0f172a",
        "plot": "#1e293b",
        "font": "#e2e8f0",
        "grid": "#334155",
        "series": [
          "#60a5fa",
          "#2dd4bf",
          "#fbbf24",
          "#f87171",
          "#a78bfa"
        ]
      }
    }
  }
}
